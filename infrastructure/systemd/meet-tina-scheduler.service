[Unit]
Description=Meet Tina Scheduler
After=network.target meet-tina-api.service

[Service]
WorkingDirectory=/opt/meet-tina-assistant/backend
EnvironmentFile=/opt/meet-tina-assistant/.env
ExecStart=/opt/meet-tina-assistant/backend/.venv/bin/python -m app.scheduler.runner
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
