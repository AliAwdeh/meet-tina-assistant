[Unit]
Description=babysitting Media Worker
After=network.target

[Service]
WorkingDirectory=/opt/meet-tina-assistant/backend
EnvironmentFile=/opt/meet-tina-assistant/.env
ExecStart=/opt/meet-tina-assistant/backend/.venv/bin/python -m app.workers.media_worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
