[Unit]
Description=babysitting API
After=network.target

[Service]
WorkingDirectory=/opt/meet-tina-assistant/backend
EnvironmentFile=/opt/meet-tina-assistant/.env
ExecStart=/opt/meet-tina-assistant/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
