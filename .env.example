APP_NAME=Meet Tina
ENVIRONMENT=production
PUBLIC_BASE_URL=https://claw.meettina.net
API_HOST=0.0.0.0
API_PORT=5000
LOG_LEVEL=INFO
REQUEST_BODY_LIMIT_BYTES=5242880

DATABASE_URL=postgresql+psycopg://meet_tina:change-me@postgres:5432/meet_tina
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
DATA_DIR=/data

JWT_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=true
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
INTERNAL_WORKER_TOKEN=replace-worker-token

AI_BASE_URL=https://langcc.maidstech.ai/v1
AI_API_KEY=
AI_CHAT_MODEL=
AI_VISION_MODEL=
AI_TRANSCRIPTION_MODEL=
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1200

OPENWA_DASHBOARD_URL=https://openwa-dashboard.meettina.net
OPENWA_API_BASE_URL=
OPENWA_WEBHOOK_SECRET=
OPENWA_API_TOKEN=
OPENWA_SESSION_ID=
OPENWA_ALLOWED_INSTANCE_ID=
OPENWA_REPLAY_WINDOW_SECONDS=300

N8N_BASE_URL=
N8N_EMAIL_WEBHOOK_URL=
N8N_CALLBACK_SECRET=
N8N_OUTBOUND_TOKEN=
N8N_ALLOWED_SOURCE_IPS=
N8N_REPLAY_WINDOW_SECONDS=300

EMAIL_APPROVAL_MODE=auto
MEETING_PREPARATION_OFFSET_HOURS=4
DEFAULT_TIMEZONE=Asia/Beirut
